# ===== 必改 =====
# 管理员账号 (默认 admin/admin, 部署后强烈建议改)
ADMIN_USER=admin
ADMIN_PASS=admin

# JWT 签名密钥 (改成你自己的一长串随机字符串)
JWT_SECRET=please-change-this-to-a-long-random-string-in-production

# 服务端口
PORT=3000

# 上传图片存储目录 (绝对路径)
UPLOAD_DIR=/var/www/chesshub-data/figures

# 前端允许跨域来源 (逗号分隔, * 表示全部允许)
CORS_ORIGIN=*
